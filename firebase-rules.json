{
  "rules": {
    "vmeste": {
      "rooms": {
        "$room": {
          ".read": "auth != null",
          "members": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          },
          "days": {
            "$date": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid"
              }
            }
          },
          "live": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    }
  }
}
